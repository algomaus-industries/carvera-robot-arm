// SO-101 pedestal for the robot cart: one PETG print on the Bambu X1.
//
// Matches the sim model (models/so101_stand, generated by
// models/so101/build_so101.py): origin on the cart top under the arm's pan
// axis, x towards the cart's middle, z up. The block overhangs the cart's
// front edge (x = CART_EDGE) by 45 mm, as a bracket over the Carvera's front
// lip; the foot reaches back onto the cart and is screwed down there.
// Numbers come from pedestal_params.scad (fab/gen_fab.py). Units: mm.
//
// The SO-101's base clamps onto the top slab with the two table clamps from
// the arm kit: the slab overhangs the walls so the clamps have a lip to grip.

include <pedestal_params.scad>

part = "pedestal";
$fn = 48;

WALL = 3.2;            // 8 perimeters of 0.4 mm
SLAB = 8;              // top slab (clamp lip)
LIP = 8;               // slab overhang past the walls, for the clamp jaws
FOOT_T = 6;
M4_WOOD = 4.5;

module pedestal() {
  x0 = PED_LO[0]; y0 = PED_LO[1]; x1 = PED_HI[0]; y1 = PED_HI[1]; h = PED_HI[2];
  difference() {
    union() {
      // walls, inset by LIP under the slab
      translate([x0 + LIP, y0 + LIP, 0]) cube([x1 - x0 - 2 * LIP, y1 - y0 - 2 * LIP, h - SLAB]);
      // top slab: full footprint of the sim block
      translate([x0, y0, h - SLAB]) cube([x1 - x0, y1 - y0, SLAB]);
      // foot onto the cart, with two gussets
      translate([CART_EDGE, y0 + LIP, 0]) cube([FOOT_X - CART_EDGE, y1 - y0 - 2 * LIP, FOOT_T]);
      for (y = [y0 + LIP, y1 - LIP - WALL])
        translate([0, y + WALL, 0]) rotate([90, 0, 0]) linear_extrude(WALL)
          polygon([[x1 - LIP - 1, 0], [FOOT_X, 0], [x1 - LIP - 1, h - SLAB - 10]]);
    }
    // hollow, open at the bottom; ribbed by the slab and the walls
    translate([x0 + LIP + WALL, y0 + LIP + WALL, -1])
      cube([x1 - x0 - 2 * LIP - 2 * WALL, y1 - y0 - 2 * LIP - 2 * WALL, h - SLAB + 1 - 2]);
    // screws into the cart top: two in the foot, one inside each corner on the cart
    for (y = [y0 + LIP + 12, y1 - LIP - 12]) {
      translate([FOOT_X - 10, y, -1]) cylinder(d = M4_WOOD, h = FOOT_T + 2);
      translate([FOOT_X - 10, y, FOOT_T - 2.5]) cylinder(d1 = M4_WOOD, d2 = 9, h = 2.6);
    }
    // cable slot under the slab for the arm's bus and power; the block is
    // open at the bottom, so they run down through a hole in the cart top
    translate([x0 + LIP - 1, (y0 + y1) / 2 - 7, h - SLAB - 14]) cube([WALL + 2, 14, 10]);
  }
}

pedestal();
