# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates
#
# cnc_enclosure is a Makera Carvera (models/makera_carvera). Its back sits
# against the cell's left wall with the lid opening towards the robot.
# lid_joint: 0 = closed, 1.4866 rad = fully open.

updates: {
  update_transform {
    node_a {
      by_name {
        object {
          object_name: "enclosure"
        }
      }
    }
    node_b {
      by_name {
        object {
          object_name: "cnc_enclosure"
        }
      }
    }
    node_to_update: {
      by_name {
        object {
          object_name: "cnc_enclosure"
        }
      }
    }
    a_t_b {
      position {
        x: -0.46
        y: -0.23
        z: 1.025
      }
      orientation {
        x: 0
        y: 0
        z: 0.7071068
        w: 0.7071068
      }
    }
  }
}
updates: {
  update_object_joints {
    object {
      by_name {
        object_name: "cnc_enclosure"
      }
    }
    joint_positions: 1.4866
  }
}
