# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates
#
# Tool-bit storage grid (models/bit_grid) on the table, robot side.
# The 81 Makera bits (models/makera_bits), bit_<id>, in catalogue order
# row by row from cell_0_0 (35 mm pitch, seats 47 mm above the
# grid base). //tools/atc:move_bit moves them to and from the Carvera ATC.
updates {
  update_transform {
    node_a { by_name { object { object_name: "enclosure" } } }
    node_b { by_name { object { object_name: "bit_grid" } } }
    node_to_update { by_name { object { object_name: "bit_grid" } } }
    a_t_b {
      position { x: 0.13500 y: 0.30500 z: 1.02500 }
      orientation { x: 0.000000 y: 0.000000 z: 0.000000 w: 1.000000 }
    }
  }
}
