# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates
#
# Makera Carvera ATC. The rack frames atc_slot_0 (probe) .. atc_slot_6 come
# with the cnc_enclosure (makera_carvera) object. This file seats one tool
# holder in slot T1 and teaches a top-down approach / grasp pair for it, in
# the same tool orientation as vise_place. Slot T1 in the cell: (-0.4905, -0.0400, 1.1750).
# grasp puts the Hand-E fingertips (tool_frame) 10 mm above the seat so the
# pads close on the holder's grip band; fingers should close across the row.

updates {
  update_transform {
    node_a {
      by_name {
        object {
          object_name: "cnc_enclosure"
        }
      }
    }
    node_b {
      by_name {
        object {
          object_name: "tool_holder_t1"
        }
      }
    }
    node_to_update {
      by_name {
        object {
          object_name: "tool_holder_t1"
        }
      }
    }
    a_t_b {
      position {
        x: 0.19000
        y: 0.03052
        z: 0.15000
      }
      orientation {
        w: 1
      }
    }
  }
}
updates {
  create_frame {
    new_frame_name: "atc_t1_pre_grasp"
    parent_t_new_frame {
      position {
        x: -0.4905
        y: -0.0400
        z: 1.2650
      }
      orientation {
        x: 0.7071068
        y: -0.7071068
        z: 0
        w: 0
      }
    }
    parent_object_with_filter {
      reference {
        by_name {
          object_name: "root"
        }
      }
    }
  }
}
updates {
  create_frame {
    new_frame_name: "atc_t1_grasp"
    parent_t_new_frame {
      position {
        x: -0.4905
        y: -0.0400
        z: 1.1850
      }
      orientation {
        x: 0.7071068
        y: -0.7071068
        z: 0
        w: 0
      }
    }
    parent_object_with_filter {
      reference {
        by_name {
          object_name: "root"
        }
      }
    }
  }
}
