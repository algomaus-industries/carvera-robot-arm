# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates
#
# Makera Carvera ATC. The rack frames atc_slot_0 (probe) .. atc_slot_6 come
# with the cnc_enclosure (makera_carvera) object; tool holders T1..T6
# (tool_holder_t1..t6) are seated in them here. For each slot a top-down
# approach / grasp pair is taught, in the same tool orientation as
# vise_place: atc_tN_grasp puts the Hand-E fingertips (tool_frame) 6 mm above
# the seat so the pads close on the 15 mm collet holder; atc_tN_pre_grasp is
# 90 mm above that. Generated from models/makera_carvera/build_carvera.py
# constants (RACK_CX, MCS_Y0, slot table) - regenerate if those change.

updates {
  update_transform {
    node_a { by_name { object { object_name: "cnc_enclosure" } } }
    node_b { by_name { object { object_name: "tool_holder_t1" } } }
    node_to_update { by_name { object { object_name: "tool_holder_t1" } } }
    a_t_b {
      position { x: 0.20500 y: 0.03052 z: 0.15000 }
      orientation { w: 1 }
    }
  }
}
updates {
  create_frame {
    new_frame_name: "atc_t1_pre_grasp"
    parent_t_new_frame {
      position { x: -0.4905 y: -0.0250 z: 1.2710 }
      orientation { x: 0.7071068 y: -0.7071068 z: 0 w: 0 }
    }
    parent_object_with_filter { reference { by_name { object_name: "root" } } }
  }
}
updates {
  create_frame {
    new_frame_name: "atc_t1_grasp"
    parent_t_new_frame {
