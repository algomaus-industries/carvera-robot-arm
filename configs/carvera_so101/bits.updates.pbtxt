  update_transform {
    node_a { by_name { frame { object_name: "bit_grid" frame_name: "cell_0_0" } } }
    node_b { by_name { object { object_name: "bit_ofl4_22" } } }
    node_to_update { by_name { object { object_name: "bit_ofl4_22" } } }
    a_t_b {
      position { x: 0.00000 y: 0.00000 z: 0.00000 }
      orientation { x: 0.000000 y: 0.000000 z: 0.000000 w: 1.000000 }
    }
  }
}
