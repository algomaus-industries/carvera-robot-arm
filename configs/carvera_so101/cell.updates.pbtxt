# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates
#
# SO-101 cell (--//:setup=carvera_so101): the Carvera on a Kuepper workshop
# bench (models/carvera_bench, 60 x 60 cm, top 0.84 m) and, in front of it, a rolling cart
# (models/robot_cart) carrying the SO-101 on a plywood pedestal and the
# bit carousel (models/bit_carousel, instance bit_grid) with every bit. The
# carousel's seat plate is level with the ATC seats; the pedestal's bracket
# puts the pan axis at world (-0.22, -0.025), just inside the open hood, and
# the arm base 5 cm above the grip height: ATC T1 0.27 m .. T6 0.12 m and the
# carousel's pick positions 0.16..0.225 m from the pan axis, all inside the
# SO-101's vertical-gripper reach. move_bit turns the carousel
# (carousel_joint) to bring a seat to its ring's pick position.
# The vise comes from configs/omts/schunk.updates.pbtxt (relative to the Carvera).
updates {
  update_transform {
    node_a { by_name { object { object_name: "root" } } }
    node_b { by_name { object { object_name: "carvera_bench" } } }
    node_to_update { by_name { object { object_name: "carvera_bench" } } }
    a_t_b {
      position { x: -0.50000 y: -0.23000 z: 0.00000 }
      orientation { x: 0.000000 y: 0.000000 z: 0.707107 w: 0.707107 }
    }
  }
}
updates {
  update_transform {
    node_a { by_name { object { object_name: "root" } } }
    node_b { by_name { object { object_name: "cnc_enclosure" } } }
    node_to_update { by_name { object { object_name: "cnc_enclosure" } } }
    a_t_b {
      position { x: -0.46000 y: -0.23000 z: 0.84000 }
      orientation { x: 0.000000 y: 0.000000 z: 0.707107 w: 0.707107 }
    }
  }
}
updates {
  update_object_joints {
    object { by_name { object_name: "cnc_enclosure" } }
    joint_positions: 1.4866   # Carvera hood fully open
  }
}
updates {
  update_transform {
    node_a { by_name { object { object_name: "root" } } }
    node_b { by_name { object { object_name: "robot_cart" } } }
    node_to_update { by_name { object { object_name: "robot_cart" } } }
    a_t_b {
      position { x: -0.01750 y: -0.15250 z: 0.00000 }
      orientation { x: 0.000000 y: 0.000000 z: 0.000000 w: 1.000000 }
    }
  }
}
updates {
  update_transform {
    node_a { by_name { object { object_name: "root" } } }
    node_b { by_name { object { object_name: "so101_stand" } } }
    node_to_update { by_name { object { object_name: "so101_stand" } } }
    a_t_b {
      position { x: -0.22000 y: -0.02500 z: 0.91500 }
      orientation { x: 0.000000 y: 0.000000 z: 0.000000 w: 1.000000 }
    }
  }
}
updates {
  update_transform {
    node_a { by_name { frame { object_name: "so101_stand" frame_name: "arm_mount" } } }
    node_b { by_name { object { object_name: "so101_arm" } } }
    node_to_update { by_name { object { object_name: "so101_arm" } } }
    a_t_b {
      position { x: 0.00000 y: 0.00000 z: 0.00000 }
      orientation { x: 0.000000 y: 0.000000 z: 0.000000 w: 1.000000 }
    }
  }
}
updates {
  update_transform {
    node_a { by_name { frame { object_name: "so101_arm" frame_name: "flange" } } }
    node_b { by_name { object { object_name: "so101_gripper" } } }
    node_to_update { by_name { object { object_name: "so101_gripper" } } }
    a_t_b {
      position { x: 0.00000 y: 0.00000 z: 0.00000 }
      orientation { x: 0.000000 y: 0.000000 z: 0.000000 w: 1.000000 }
    }
  }
}
updates {
  reparent_object {
    object { by_name { object_name: "so101_gripper" } }
    parent_frame { by_name { object_name: "so101_arm" frame_name: "flange" } }
  }
}
updates {
  update_transform {
    node_a { by_name { frame { object_name: "so101_stand" frame_name: "grid_mount" } } }
    node_b { by_name { object { object_name: "bit_grid" } } }
    node_to_update { by_name { object { object_name: "bit_grid" } } }
    a_t_b {
      position { x: 0.00000 y: 0.00000 z: 0.00000 }
      orientation { x: 0.000000 y: 0.000000 z: 0.000000 w: 1.000000 }
    }
  }
}
# Home: tool frame at the arm's start / home configuration [-1.571, -0.743, 0.43, 1.618, 0.0]
# (gripper 13 cm up, turned over the grid). move_bit returns here.
updates {
  create_frame {
    new_frame_name: "view"
    parent_t_new_frame {
      position { x: -0.08419 y: -0.02498 z: 1.15522 }
      orientation { x: 0.024018 y: 0.990890 z: 0.003241 w: 0.132474 }
    }
    parent_object_with_filter { reference { by_name { object_name: "root" } } }
  }
}
