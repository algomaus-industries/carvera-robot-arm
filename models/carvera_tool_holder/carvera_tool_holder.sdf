<!-- Makera Carvera ATC tool holder with collet nut and bit (estimated shape).
     Origin on the rack seat (atc_slot_N frame); collision only above the seat.
     grip_frame is the centre of the grip band. -->
<sdf xmlns:intrinsic="https://intrinsic.ai/" version="1.9">
  <model name="carvera_tool_holder">
    <link name="base_link">
      <inertial><mass>0.06</mass></inertial>
      <visual name="holder_visual">
        <geometry><mesh><uri>carvera_tool_holder.glb</uri></mesh></geometry>
      </visual>
      <collision name="holder_collision">
        <pose>0.00000 0.00000 0.00925 0.00000 0.00000 0.00000</pose>
        <geometry><cylinder><radius>0.00750</radius><length>0.01750</length></cylinder></geometry>
      </collision>
      <collision name="shank_collision">
        <pose>0.00000 0.00000 0.02600 0.00000 0.00000 0.00000</pose>
        <geometry><cylinder><radius>0.00160</radius><length>0.01600</length></cylinder></geometry>
      </collision>
    </link>
    <frame name="grip_frame" attached_to="base_link" intrinsic:create_entity="true">
      <pose>0 0 0.010 0 0 0</pose>
    </frame>
  </model>
</sdf>
