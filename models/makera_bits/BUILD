load("@intrinsic-core//intrinsic/scene/build_defs:sdf_scene_object.bzl", "sdf_scene_object")
load("@intrinsic-core//intrinsic_sdk/intrinsic/assets/scene_objects/build_defs:scene_object.bzl", "intrinsic_scene_object")
load(":bits.bzl", "MAKERA_BITS")

package(default_visibility = ["//visibility:public"])

# One scene object per bit Makera sells for the Carvera. Generated by
#   blender -b --python models/makera_bits/build_bits.py -- models
# (writes the .sdf, .glb, manifests, bits.bzl and makera_bits.json).

exports_files([
    "bits.bzl",
    "makera_bits.json",
])

[
    sdf_scene_object(
        name = bit + "_scene_object",
        src = bit + ".sdf",
        sdf_assets = [bit + ".glb"],
    )
    for bit in MAKERA_BITS
]

[
    intrinsic_scene_object(
        name = bit,
        manifest = ":" + bit + "_manifest.textproto",
        scene_object = ":" + bit + "_scene_object",
    )
    for bit in MAKERA_BITS
]

filegroup(
    name = "all_bits",
    srcs = [":" + bit for bit in MAKERA_BITS],
)
